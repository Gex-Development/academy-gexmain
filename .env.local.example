# Copie para `.env.local` e preencha. O `.env.local` nunca é commitado.
# Os valores vêm do painel do Supabase → Project Settings → API.

# URL e chave pública do projeto Supabase (podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Segredos — NUNCA prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Usados só por scripts/db.mjs (npm run db:push / db:reset / db:types), para
# montar a connection string direta com o Postgres do projeto — não pelo
# Next.js. Painel do Supabase → Project Settings → General (Reference ID) e
# → Database (senha definida na criação do projeto, ou redefinida ali).
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

EMAIL_FROM="GEX Academy <academy@gexcorp.com.br>"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
